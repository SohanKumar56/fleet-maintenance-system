# Environment variables template
# Copy this file to .env and update with actual values
# DO NOT commit the actual .env file with real credentials

# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_NAME=fleet_maintenance
DB_USER=your_db_user
DB_PASSWORD=your_db_password

# Application Configuration
APP_PORT=8080
FRONTEND_PORT=3000

# Security
JWT_SECRET=your_jwt_secret_key_here

# External Services (if any)
API_KEY=your_api_key_here

# Note: Actual values will be configured during Task 12 - Docker implementation